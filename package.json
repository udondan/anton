{
  "name": "@udondan/anton",
  "version": "1.6.0",
  "description": "Unofficial SDK, CLI, and MCP server for anton.app — track children's learning progress, browse lessons, manage assignments",
  "repository": {
    "type": "git",
    "url": "https://github.com/udondan/anton.git"
  },
  "author": {
    "name": "Daniel Schroeder",
    "email": "deemes79@googlemail.com",
    "url": "https://udondan.com/"
  },
  "license": "MIT",
  "mcpName": "io.github.udondan/anton",
  "keywords": [
    "anton",
    "anton.app",
    "mcp",
    "mcp-server",
    "cli",
    "sdk",
    "parental-monitoring",
    "education",
    "learning"
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/udondan"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "anton": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js mcp",
    "pretest": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:coverage": "tsc",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ test/",
    "lint:tools": "tdqs lint --command \"node dist/cli.js mcp\" --server-name anton --fail-on warning",
    "lint:fix": "eslint --fix src/ test/",
    "format": "prettier --write src/ test/"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "axios": "1.21.1",
    "commander": "15.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/inspector": "2.16.0",
    "@types/node": "26.6.10",
    "@vitest/coverage-v8": "5.1.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "mcp-tdqs": "0.2.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  },
  "overrides": {
    "minimatch": "11.0.9"
  }
}
